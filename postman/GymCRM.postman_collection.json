{
  "info": {
    "name": "Gym CRM REST API",
    "description": "All 17 endpoints. Run requests top to bottom inside each folder - registration requests auto-save the generated username/password into collection variables, which the rest of the requests reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "traineeUsername", "value": "" },
    { "key": "traineePassword", "value": "" },
    { "key": "trainerUsername", "value": "" },
    { "key": "trainerPassword", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register Trainer",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const body = pm.response.json();",
          "pm.collectionVariables.set('trainerUsername', body.username);",
          "pm.collectionVariables.set('trainerPassword', body.password);"
        ]}
      }],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/trainers",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Anna\",\n  \"lastName\": \"Lee\",\n  \"specialization\": \"Yoga\"\n}" }
      }
    },
    {
      "name": "2. Register Trainee",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const body = pm.response.json();",
          "pm.collectionVariables.set('traineeUsername', body.username);",
          "pm.collectionVariables.set('traineePassword', body.password);"
        ]}
      }],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/trainees",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"address\": \"Tashkent, Chilonzor\"\n}" }
      }
    },
    {
      "name": "3. Login (Trainee)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/login?username={{traineeUsername}}&password={{traineePassword}}"
      }
    },
    {
      "name": "4. Change Login (Trainee)",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{traineeUsername}}\",\n  \"oldPassword\": \"{{traineePassword}}\",\n  \"newPassword\": \"NewPass123\"\n}" }
      }
    },
    {
      "name": "4b. (Postman) Remember the new trainee password",
      "event": [{
        "listen": "prerequest",
        "script": { "exec": [
          "pm.collectionVariables.set('traineePassword', 'NewPass123');"
        ]}
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/training-types" }
    },
    {
      "name": "5. Get Trainee Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]}
      }
    },
    {
      "name": "6. Update Trainee Profile",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{traineeUsername}}\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"address\": \"Tashkent, Yunusobod\",\n  \"isActive\": true\n}" }
      }
    },
    {
      "name": "8. Get Trainer Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trainers/{{trainerUsername}}",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{trainerUsername}}" },
          { "key": "password", "value": "{{trainerPassword}}" }
        ]}
      }
    },
    {
      "name": "9. Update Trainer Profile",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/trainers/{{trainerUsername}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{trainerUsername}}" },
          { "key": "password", "value": "{{trainerPassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{trainerUsername}}\",\n  \"firstName\": \"Anna\",\n  \"lastName\": \"Lee\",\n  \"isActive\": true\n}" }
      }
    },
    {
      "name": "10. Get Unassigned Active Trainers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}/unassigned-trainers",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]}
      }
    },
    {
      "name": "11. Update Trainee's Trainer List",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}/trainers",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"traineeUsername\": \"{{traineeUsername}}\",\n  \"trainers\": [\"{{trainerUsername}}\"]\n}" }
      }
    },
    {
      "name": "14. Add Training",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/trainings",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"traineeUsername\": \"{{traineeUsername}}\",\n  \"trainerUsername\": \"{{trainerUsername}}\",\n  \"trainingName\": \"Morning Yoga\",\n  \"trainingDate\": \"2026-09-01\",\n  \"trainingDuration\": 60\n}" }
      }
    },
    {
      "name": "12. Get Trainee Trainings List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}/trainings",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]}
      }
    },
    {
      "name": "13. Get Trainer Trainings List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/trainers/{{trainerUsername}}/trainings",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{trainerUsername}}" },
          { "key": "password", "value": "{{trainerPassword}}" }
        ]}
      }
    },
    {
      "name": "15. Activate/Deactivate Trainee",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}/status",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{traineeUsername}}\",\n  \"isActive\": false\n}" }
      }
    },
    {
      "name": "16. Activate/Deactivate Trainer",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/trainers/{{trainerUsername}}/status",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{trainerUsername}}" },
          { "key": "password", "value": "{{trainerPassword}}" }
        ]},
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{trainerUsername}}\",\n  \"isActive\": false\n}" }
      }
    },
    {
      "name": "17. Get Training Types",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/training-types"
      }
    },
    {
      "name": "7. Delete Trainee Profile (run last)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/trainees/{{traineeUsername}}",
        "auth": { "type": "basic", "basic": [
          { "key": "username", "value": "{{traineeUsername}}" },
          { "key": "password", "value": "{{traineePassword}}" }
        ]}
      }
    }
  ]
}